<mujoco model="stick_human_structured">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
    
    <option integrator="RK4" timestep="0.01" gravity="0 0 -0"/>

    <default>
        <joint armature="0.01" damping="0.1" limited="true"/>
        <geom contype="1" conaffinity="1" condim="3" density="1000" friction=".5 .1 .1" rgba="0.8 0.6 0.4 1"/>
    </default>

    <worldbody>
        <!-- Root: Pelvis -->
        <body name="pelvis" pos="0 0 1.0" euler="0 0 90">
            <freejoint name="root"/>
            <!-- Pelvis Crossbar -->
            <geom name="pelvis_geom" type="capsule" fromto="-0.1 0 0 0.1 0 0" size="0.05"/>
            
            <body name="torso" pos="0 0 0">
                <!-- Main Spine -->
                <geom name="spine" type="capsule" fromto="0 0 0 0 0 0.6" size="0.045"/>
                
                <!-- Shoulder Yoke: Connected at the top of the spine (0.6) -->
                <body name="shoulders" pos="0 0 0.6">
                    <geom name="shoulder_bar" type="capsule" fromto="-0.15 0 0 0.15 0 0" size="0.04"/>
                    
                    <!-- Neck: Extending from the center of the shoulder bar -->
                    <body name="neck" pos="0 0 0">
                        <geom name="neck_geom" type="capsule" fromto="0 0 0 0 0 0.1" size="0.03"/>
                        <!-- Head: Attached to the top of the neck -->
                        <body name="head" pos="0 0 0.18">
                            <geom name="head_geom" type="sphere" size="0.08"/>
                        </body>
                    </body>

                    <!-- Right Arm: Attached to the right end of the shoulder bar (-0.15) -->
                    <body name="right_upper_arm" pos="-0.15 0 0">
                        <joint name="right_shoulder" type="ball" range="0 180"/>
                        <geom name="rua_geom" type="capsule" fromto="0 0 0 0 -0.24 0" size="0.03"/>
                        <body name="right_lower_arm" pos="0 -0.24 0">
                            <joint name="right_elbow" type="hinge" pos="0 0 0" axis="0 0 1" range="0 150"/>
                            <geom name="rla_geom" type="capsule" fromto="0 0 0 0 -0.24 0" size="0.025"/>
                        </body>
                    </body>

                    <!-- Left Arm: Attached to the left end of the shoulder bar (0.15) -->
                    <body name="left_upper_arm" pos="0.15 0 0">
                        <joint name="left_shoulder" type="ball" range="0 180"/>
                        <geom name="lua_geom" type="capsule" fromto="0 0 0 0 0.24 0" size="0.03"/>
                        <body name="left_lower_arm" pos="0 0.24 0">
                            <joint name="left_elbow" type="hinge" pos="0 0 0" axis="0 0 1" range="-150 0"/>
                            <geom name="lla_geom" type="capsule" fromto="0 0 0 0 0.24 0" size="0.025"/>
                        </body>
                    </body>
                </body >
            </body>

            <!-- Right Leg -->
            <body name="right_thigh" pos="-0.1 0 0">
                <joint name="right_hip" type="ball" range="0 90"/>
                <geom name="rt_geom" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.035"/>
                <body name="right_shin" pos="0 0 -0.4">
                    <joint name="right_knee" type="hinge" pos="0 0 0" axis="0 1 0" range="0 150"/>
                    <geom name="rs_geom" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03"/>
                </body>
            </body>

            <!-- Left Leg -->
            <body name="left_thigh" pos="0.1 0 0">
                <joint name="left_hip" type="ball" range="0 90"/>
                <geom name="lt_geom" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.035"/>
                <body name="left_shin" pos="0 0 -0.4">
                    <joint name="left_knee" type="hinge" pos="0 0 0" axis="0 1 0" range="0 150"/>
                    <geom name="ls_geom" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor joint="right_shoulder" ctrlrange="-10.0 10.0"/>
        <motor joint="right_elbow" ctrlrange="-5.00 5.0"/>
        <motor joint="left_shoulder" ctrlrange="-10.0 10.0"/>
        <motor joint="left_elbow" ctrlrange="-5.0 5.0"/>
        <motor joint="right_hip" ctrlrange="-10.0 10.0"/>
        <motor joint="right_knee" ctrlrange="-7.0 7.0"/>
        <motor joint="left_hip" ctrlrange="-10.0 10.0"/>
        <motor joint="left_knee" ctrlrange="-7.0 7.0"/>
    </actuator>
</mujoco>